# Copy to .env. Never commit the copied file.

# Select providers. Values override config/providers.yaml.
LAW_API_STORAGE_PROVIDER=postgresql
LAW_API_EMBEDDING=bge-m3

# Qdrant is an alternative provider; it is unused while PostgreSQL is selected.
LAW_API_QDRANT_PATH=storage/qdrant
LAW_API_QDRANT_URL=
LAW_API_QDRANT_COLLECTION=law_chunks

# Keep this value private and change it for your PostgreSQL installation.
LAW_API_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/legal

# MLflow tracking server.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=legal-rag-embeddings

# LLM provider selection. Values override config/providers.yaml.
# LAW_API_LLM_API_KEY is a secret and must only ever live in .env.
LAW_API_LLM_PROVIDER=openai
LAW_API_LLM_MODEL=gpt-4o-mini
LAW_API_LLM_BASE_URL=
LAW_API_LLM_API_KEY=
LAW_API_LLM_TEMPERATURE=0.0
LAW_API_LLM_MAX_TOKENS=512
LAW_API_RAG_TOP_K=5

# Application paths and limits.
LAW_API_UPLOAD_DIR=storage/uploads
LAW_API_PENDING_DIR=storage/pending
LAW_API_MAX_UPLOAD_BYTES=52428800

# ---- Docker / vLLM ----
# HF cache bind mount (WSL path by default; Windows path when running compose from Windows).
HF_CACHE=/mnt/c/Users/Ali/.cache/huggingface
# Write any HF model ID — vLLM serves it and downloads the weights into the mounted cache.
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
VLLM_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ---- Evaluation (ragas) ----
# The EVALUATED model is the generation model (serves /ask); the judge only scores its answers.
LAW_API_EVAL_GENERATION_BASE_URL=http://127.0.0.1:8001/v1
LAW_API_EVAL_GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
LAW_API_EVAL_JUDGE_BASE_URL=http://127.0.0.1:8002/v1
LAW_API_EVAL_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ---- Langfuse observability (secrets) ----
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
