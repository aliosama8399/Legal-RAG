# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Raw/generated data are tracked by DVC (the .dvc pointer files ARE committed)
data/raw/*
!data/raw/*.dvc
data/corpus/*
data/processed/*
data/eval/*
src/data/processed/*
storage/
mlruns/
storage/qdrant/
storage/mlartifacts/
.dvc/cache/

# Env / secrets
.env
*.local

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/

# MLflow / models / artifacts
mlruns/
artifacts/
*.onnx
*.safetensors
*.gguf

# Generated reports. The HTML/CSV load-test output is a few MB and is
# regenerated by `docker compose --profile loadtest run --rm loadtest`;
# reports/README.md documents how to reproduce it.
reports/*
!reports/README.md

# OS
Thumbs.db
.DS_Store
.dockerignore
.gitignore
.opencode
# Frontend build artifacts. The image builds these inside Docker; they are not
# source and node_modules is large.
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
