# syntax=docker/dockerfile:1.7
# ---------- stage 1: build the venv + the bento (uv lives only here) ----------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first (cached layer). Lockfile-driven; torch resolves to the
# CPU wheel via [tool.uv.sources] in pyproject.toml.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra serve

# Application code + config + BentoML service definition.
COPY src ./src
COPY config ./config
COPY bento_service.py bentofile.yaml ./

# Install the project itself into the venv.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra serve

# The PII guardrail ships a regex engine that needs no model, so the image builds
# without any download. To upgrade detection to presidio, install the spaCy model
# here — note it is published only on GitHub releases, which a TLS-intercepting
# proxy may block (that is why it is not a build step by default):
#   RUN python -m spacy download en_core_web_sm

# Build the bento at image-build time so the container only serves it.
ENV PATH="/app/.venv/bin:$PATH"
RUN bentoml build

# ---------- stage 2: slim runtime (no uv, no build cache, no pip cache) ----------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TOKENIZERS_PARALLELISM=false \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app
COPY --from=builder /app /app
COPY --from=builder /root/bentoml /root/bentoml

EXPOSE 3000

# Call bentoml directly: `uv run` would re-check/re-sync the environment on
# every container start.
CMD ["bentoml", "serve", "law-rag:latest", "--host", "0.0.0.0", "--port", "3000"]